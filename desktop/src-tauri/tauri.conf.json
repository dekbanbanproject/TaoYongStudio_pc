{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaoYongStudio",
  "version": "2.0.0",
  "identifier": "com.taoyongstudio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TaoYongStudio",
        "width": 1600,
        "height": 950,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#F5F4FF"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' asset: http://asset.localhost blob: file: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../engine/taoyong/**/*",
      "../../scripts/**/*",
      "../../plans/**/*",
      "../../fonts/**/*",
      "../../nextseller/data/**/*",
      "../../assets/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "shortcutName": "TaoYongStudio"
      }
    },
    "copyright": "TaoYongStudio",
    "category": "Video",
    "shortDescription": "TaoYongStudio Desktop",
    "longDescription": "โปรแกรมสร้างคลิปการ์ตูนเด็ก AI สำหรับ TikTok, YouTube, Shopee และ Facebook"
  }
}
